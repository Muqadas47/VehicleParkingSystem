@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Parking Pro</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", sans-serif;
            background: #101318;
            color: #f4f4f4;
        }

        /* BACKGROUND */

        .page-background {
            position: fixed;
            inset: 0;
            background-image: linear-gradient( rgba(10, 13, 18, 0.88), rgba(10, 13, 18, 0.94) ), url("https://images.unsplash.com/photo-1506521781263-d8422e82f27a?auto=format&fit=crop&w=2000&q=85");
            background-size: cover;
            background-position: center;
            z-index: -2;
        }

            .page-background::after {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient( circle at 75% 20%, rgba(67, 132, 255, 0.12), transparent 35% );
            }


        /* MAIN */

        .main {
            min-height: 100vh;
            padding: 30px 40px;
        }


        /* TOP BAR */

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 35px;
        }

        .topbar-title h2 {
            margin: 0;
            font-size: 25px;
            font-weight: 600;
        }

        .topbar-title p {
            margin: 5px 0 0;
            color: #8f96a3;
            font-size: 13px;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .profile-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #28303d;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .profile-name {
            font-size: 14px;
            font-weight: 600;
        }

        .profile-role {
            color: #7e8591;
            font-size: 11px;
        }


        /* STATISTICS */

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: rgba(25, 29, 36, 0.88);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 14px;
            padding: 20px;
            backdrop-filter: blur(10px);
        }

        .stat-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .stat-label {
            color: #8f96a3;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-icon {
            width: 38px;
            height: 38px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(61,126,255,0.13);
            color: #5f95ff;
        }

        .stat-number {
            margin-top: 15px;
            font-size: 28px;
            font-weight: 600;
        }


        /* CONTENT GRID */

        .content-grid {
            display: grid;
            grid-template-columns: 1.35fr 0.65fr;
            gap: 20px;
        }

        .panel {
            background: rgba(20, 24, 30, 0.91);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 15px;
            padding: 25px;
            backdrop-filter: blur(12px);
        }

        .panel-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 23px;
        }

            .panel-title h4 {
                margin: 0;
                font-size: 17px;
                font-weight: 600;
            }

            .panel-title span {
                color: #747c89;
                font-size: 12px;
            }


        /* FORM */

        .form-label {
            color: #aeb4bf;
            font-size: 12px;
            margin-bottom: 8px;
        }

        .form-control,
        .form-select {
            background: #171b21;
            border: 1px solid #303640;
            color: #ffffff;
            padding: 12px 13px;
            border-radius: 8px;
        }

            .form-control:focus,
            .form-select:focus {
                background: #171b21;
                color: #ffffff;
                border-color: #3d7eff;
                box-shadow: 0 0 0 3px rgba(61,126,255,0.12);
            }

            .form-control::placeholder {
                color: #606773;
            }

            .form-select option {
                background: #171b21;
            }


        /* BUTTONS */

        .primary-button {
            width: 100%;
            border: 0;
            background: #3d7eff;
            color: #ffffff;
            padding: 12px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            margin-top: 8px;
        }

            .primary-button:hover {
                background: #326fe8;
            }


        /* PARKING STATUS */

        .parking-circle {
            width: 145px;
            height: 145px;
            border-radius: 50%;
            margin: 12px auto 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 10px solid #263141;
            box-shadow: inset 0 0 0 5px #171b21;
        }

            .parking-circle strong {
                font-size: 31px;
            }

            .parking-circle span {
                color: #7d8591;
                font-size: 11px;
            }

        .status-line {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            font-size: 13px;
        }

            .status-line:last-child {
                border-bottom: 0;
            }

        .status-value {
            color: #ffffff;
            font-weight: 600;
        }


        /* LOWER GRID */

        .lower-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 20px;
        }

        .message {
            min-height: 20px;
            margin-top: 12px;
            font-size: 12px;
            color: #8f96a3;
        }


        /* TICKET */

        #ticketPanel {
            display: none;
        }

        .ticket {
            background: #f6f7f9;
            color: #17191d;
            border-radius: 12px;
            padding: 25px;
            max-width: 440px;
            margin: auto;
        }

        .ticket-header {
            text-align: center;
            border-bottom: 1px dashed #aeb2b8;
            padding-bottom: 18px;
            margin-bottom: 18px;
        }

            .ticket-header i {
                font-size: 25px;
                color: #315fbe;
                margin-bottom: 8px;
            }

            .ticket-header h3 {
                margin: 0;
                font-size: 18px;
                font-weight: 700;
            }

            .ticket-header p {
                margin: 3px 0 0;
                color: #72767d;
                font-size: 11px;
            }

        .ticket-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 13px;
        }

            .ticket-row span:first-child {
                color: #747980;
            }

            .ticket-row span:last-child {
                font-weight: 600;
            }

        .ticket-footer {
            text-align: center;
            border-top: 1px dashed #aeb2b8;
            margin-top: 15px;
            padding-top: 15px;
            color: #747980;
            font-size: 10px;
        }

        .print-button {
            width: 100%;
            margin-top: 18px;
            border: 0;
            padding: 11px;
            border-radius: 8px;
            background: #171b21;
            color: white;
            font-size: 12px;
        }


        /* RESPONSIVE */

        @@media (max-width: 1100px) {

            .stats-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 750px) {

            .main {
                padding: 25px 18px;
            }

            .stats-grid,
            .lower-grid {
                grid-template-columns: 1fr;
            }
        }


        /* PRINT */

        @@media print {

            body * {
                visibility: hidden;
            }

            #ticketPanel,
            #ticketPanel * {
                visibility: visible;
            }

            #ticketPanel {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                display: block !important;
                background: white;
            }

            .ticket {
                margin: 30px auto;
                box-shadow: none;
            }

            .print-button {
                display: none;
            }
        }
    </style>

</head>


<body>

    <div class="page-background"></div>


    <!-- MAIN -->

    <main class="main"
          id="dashboard">


        <!-- TOP BAR -->

        <div class="topbar">

            <div class="topbar-title">

                <h2>
                    Parking Dashboard
                </h2>

                <p>
                    Manage your parking operations from one place.
                </p>

            </div>


            <div class="profile">

                <div class="profile-icon">

                    <i class="fa-solid fa-user"></i>

                </div>

                <div>

                    <div class="profile-name"
                         id="userName">
                        User
                    </div>

                    <div class="profile-role">
                        Parking System User
                    </div>

                </div>

            </div>

        </div>


        <!-- STATISTICS -->

        <div class="stats-grid">

            <div class="stat-card">

                <div class="stat-top">

                    <span class="stat-label">
                        Total Spaces
                    </span>

                    <div class="stat-icon">

                        <i class="fa-solid fa-square-parking"></i>

                    </div>

                </div>

                <div class="stat-number"
                     id="totalSpaces">
                    -
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-top">

                    <span class="stat-label">
                        Available
                    </span>

                    <div class="stat-icon">

                        <i class="fa-solid fa-check"></i>

                    </div>

                </div>

                <div class="stat-number"
                     id="availableSpaces">
                    -
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-top">

                    <span class="stat-label">
                        Occupied
                    </span>

                    <div class="stat-icon">

                        <i class="fa-solid fa-car-side"></i>

                    </div>

                </div>

                <div class="stat-number"
                     id="occupiedSpaces">
                    -
                </div>

            </div>

        </div>


        <!-- MAIN CONTENT -->

        <div class="content-grid">


            <!-- PARK VEHICLE -->

            <div class="panel"
                 id="parkSection">

                <div class="panel-title">

                    <h4>

                        <i class="fa-solid fa-car me-2"></i>

                        Park a Vehicle

                    </h4>

                    <span>
                        New parking entry
                    </span>

                </div>


                <div class="row">

                    <div class="col-md-7 mb-3">

                        <label class="form-label">
                            Vehicle Number
                        </label>

                        <input type="text"
                               id="vehicleNumber"
                               class="form-control"
                               placeholder="e.g. ABC-123" />

                    </div>


                    <div class="col-md-5 mb-3">

                        <label class="form-label">
                            Vehicle Type
                        </label>

                        <select id="vehicleType"
                                class="form-select">

                            <option value="">
                                Select type
                            </option>

                            <option value="Car">
                                Car
                            </option>

                            <option value="Bike">
                                Bike
                            </option>

                            <option value="Truck">
                                Truck
                            </option>

                        </select>

                    </div>

                </div>


                <button class="primary-button"
                        id="parkButton">

                    <i class="fa-solid fa-square-parking me-2"></i>

                    Park Vehicle

                </button>


                <div class="message"
                     id="parkMessage">
                </div>

            </div>


            <!-- STATUS -->

            <div class="panel">

                <div class="panel-title">

                    <h4>
                        Parking Status
                    </h4>

                    <span>
                        Live
                    </span>

                </div>


                <div class="parking-circle">

                    <strong id="statusPercentage">
                        -
                    </strong>

                    <span>
                        Occupied
                    </span>

                </div>


                <div class="status-line">

                    <span>
                        Total spaces
                    </span>

                    <span class="status-value"
                          id="statusTotal">
                        -
                    </span>

                </div>


                <div class="status-line">

                    <span>
                        Occupied
                    </span>

                    <span class="status-value"
                          id="statusOccupied">
                        -
                    </span>

                </div>


                <div class="status-line">

                    <span>
                        Available
                    </span>

                    <span class="status-value"
                          id="statusAvailable">
                        -
                    </span>

                </div>

            </div>

        </div>


        <!-- EXIT + PAYMENT -->

        <div class="lower-grid">


            <!-- EXIT -->

            <div class="panel"
                 id="exitSection">

                <div class="panel-title">

                    <h4>

                        <i class="fa-solid fa-right-from-bracket me-2"></i>

                        Vehicle Exit

                    </h4>

                    <span>
                        Calculate parking fee
                    </span>

                </div>


                <label class="form-label">
                    Ticket Number
                </label>

                <input type="text"
                       id="exitTicketNumber"
                       class="form-control"
                       placeholder="TKT-20261001163651" />


                <button class="primary-button"
                        id="exitButton">

                    <i class="fa-solid fa-calculator me-2"></i>

                    Exit & Calculate Fee

                </button>


                <div class="message"
                     id="exitMessage">
                </div>

            </div>


            <!-- PAYMENT -->

            <div class="panel"
                 id="paymentSection">

                <div class="panel-title">

                    <h4>

                        <i class="fa-solid fa-credit-card me-2"></i>

                        Payment

                    </h4>

                    <span>
                        Complete payment
                    </span>

                </div>


                <label class="form-label">
                    Ticket Number
                </label>

                <input type="text"
                       id="paymentTicketNumber"
                       class="form-control mb-3"
                       placeholder="TKT-20261001163651" />


                <label class="form-label">
                    Payment Method
                </label>

                <select id="paymentMethod"
                        class="form-select">

                    <option value="">
                        Select payment method
                    </option>

                    <option value="Cash">
                        Cash
                    </option>

                    <option value="Card">
                        Card
                    </option>

                    <option value="JazzCash">
                        JazzCash
                    </option>

                </select>


                <button class="primary-button"
                        id="paymentButton">

                    <i class="fa-solid fa-money-bill-wave me-2"></i>

                    Complete Payment

                </button>


                <div class="message"
                     id="paymentMessage">
                </div>

            </div>

        </div>


        <!-- TICKET -->

        <div class="panel mt-4"
             id="ticketPanel">

            <div class="panel-title">

                <h4>

                    <i class="fa-solid fa-ticket me-2"></i>

                    Parking Ticket

                </h4>

                <span>
                    Parking entry receipt
                </span>

            </div>


            <div class="ticket">

                <div class="ticket-header">

                    <i class="fa-solid fa-square-parking"></i>

                    <h3>
                        VEHICLE PARKING
                    </h3>

                    <p>
                        OFFICIAL PARKING TICKET
                    </p>

                </div>


                <div class="ticket-row">

                    <span>
                        Ticket Number
                    </span>

                    <span id="ticketNumber">
                        -
                    </span>

                </div>


                <div class="ticket-row">

                    <span>
                        Vehicle Number
                    </span>

                    <span id="ticketVehicle">
                        -
                    </span>

                </div>


                <div class="ticket-row">

                    <span>
                        Vehicle Type
                    </span>

                    <span id="ticketType">
                        -
                    </span>

                </div>


                <div class="ticket-row">

                    <span>
                        Parking Space
                    </span>

                    <span id="ticketSpace">
                        -
                    </span>

                </div>


                <div class="ticket-row">

                    <span>
                        Entry Time
                    </span>

                    <span id="ticketEntry">
                        -
                    </span>

                </div>


                <div class="ticket-footer">

                    Please keep this ticket until vehicle exit.

                </div>


                <button class="print-button"
                        onclick="window.print()">

                    <i class="fa-solid fa-print me-2"></i>

                    Print Ticket

                </button>

            </div>

        </div>


        <div id="message"
             class="message text-center mt-3">
        </div>


    </main>


    <script>

document.addEventListener(
                            "DOMContentLoaded",
                            async function () {

                                const token =
                                    sessionStorage.getItem("jwtToken");

                                const userName =
                                    sessionStorage.getItem("userName");


                                if (!token) {

                                    window.location.href =
                                        "/Account/Login";

                                    return;
                                }


                                const userNameElement =
                                    document.getElementById("userName");

                                const totalSpacesElement =
                                    document.getElementById("totalSpaces");

                                const availableSpacesElement =
                                    document.getElementById("availableSpaces");

                                const occupiedSpacesElement =
                                    document.getElementById("occupiedSpaces");


                                const statusTotal =
                                    document.getElementById("statusTotal");

                                const statusAvailable =
                                    document.getElementById("statusAvailable");

                                const statusOccupied =
                                    document.getElementById("statusOccupied");

                                const statusPercentage =
                                    document.getElementById("statusPercentage");


                                const messageElement =
                                    document.getElementById("message");


                                const vehicleNumber =
                                    document.getElementById("vehicleNumber");

                                const vehicleType =
                                    document.getElementById("vehicleType");

                                const parkButton =
                                    document.getElementById("parkButton");

                                const parkMessage =
                                    document.getElementById("parkMessage");


                                const exitTicketNumber =
                                    document.getElementById("exitTicketNumber");

                                const exitButton =
                                    document.getElementById("exitButton");

                                const exitMessage =
                                    document.getElementById("exitMessage");


                                const paymentTicketNumber =
                                    document.getElementById("paymentTicketNumber");

                                const paymentMethod =
                                    document.getElementById("paymentMethod");

                                const paymentButton =
                                    document.getElementById("paymentButton");

                                const paymentMessage =
                                    document.getElementById("paymentMessage");


                                const ticketPanel =
                                    document.getElementById("ticketPanel");


                                if (userNameElement) {

                                    userNameElement.textContent =
                                        userName || "User";
                                }


                                /* LOAD AVAILABILITY */

                                async function loadAvailability() {

                                    try {

                                        const response =
                                            await fetch(
                                                "/api/parking/availability",
                                                {
                                                    method: "GET",

                                                    headers: {
                                                        "Authorization":
                                                            "Bearer " + token
                                                    }
                                                }
                                            );


                                        const result =
                                            await response.json();


                                        if (!response.ok) {

                                            messageElement.textContent =
                                                result.message ||
                                                "Unable to load parking information.";

                                            return;
                                        }


                                        const total =
                                            result.totalSpaces;

                                        const available =
                                            result.availableSpaces;

                                        const occupied =
                                            result.occupiedSpaces;


                                        totalSpacesElement.textContent =
                                            total;

                                        availableSpacesElement.textContent =
                                            available;

                                        occupiedSpacesElement.textContent =
                                            occupied;


                                        statusTotal.textContent =
                                            total;

                                        statusAvailable.textContent =
                                            available;

                                        statusOccupied.textContent =
                                            occupied;


                                        const percentage =
                                            total > 0
                                                ? Math.round(
                                                    (occupied / total) * 100
                                                  )
                                                : 0;


                                        statusPercentage.textContent =
                                            percentage + "%";

                                    }
                                    catch (error) {

                                        console.error(
                                            "Availability Error:",
                                            error
                                        );

                                        messageElement.textContent =
                                            "Unable to load parking information.";
                                    }
                                }


                                await loadAvailability();


                                /* PARK VEHICLE */

                                parkButton.addEventListener(
                                    "click",
                                    async function () {

                                        const number =
                                            vehicleNumber.value.trim();

                                        const type =
                                            vehicleType.value;


                                        if (!number || !type) {

                                            parkMessage.textContent =
                                                "Vehicle number and type are required.";

                                            return;
                                        }


                                        if (
                                            parseInt(
                                                availableSpacesElement.textContent
                                            ) <= 0
                                        ) {

                                            parkMessage.textContent =
                                                "No parking space is available.";

                                            return;
                                        }


                                        try {

                                            const response =
                                                await fetch(
                                                    "/api/parking/park",
                                                    {
                                                        method: "POST",

                                                        headers: {
                                                            "Content-Type":
                                                                "application/json",

                                                            "Authorization":
                                                                "Bearer " + token
                                                        },

                                                        body: JSON.stringify({

                                                            VehicleNumber:
                                                                number,

                                                            VehicleType:
                                                                type
                                                        })
                                                    }
                                                );


                                            const result =
                                                await response.json();


                                            if (!response.ok) {

                                                parkMessage.textContent =
                                                    result.message ||
                                                    "Unable to park vehicle.";

                                                return;
                                            }


                                            parkMessage.textContent =
                                                "Vehicle parked successfully.";


                                            vehicleNumber.value = "";
                                            vehicleType.value = "";


                                            /* SHOW TICKET */

                                            document.getElementById(
                                                "ticketNumber"
                                            ).textContent =
                                                result.ticketNumber;


                                            document.getElementById(
                                                "ticketVehicle"
                                            ).textContent =
                                                result.vehicleNumber;


                                            document.getElementById(
                                                "ticketType"
                                            ).textContent =
                                                result.vehicleType;


                                            document.getElementById(
                                                "ticketSpace"
                                            ).textContent =
                                                "#" + result.parkingSpaceId;


                                            document.getElementById(
                                                "ticketEntry"
                                            ).textContent =
                                                new Date(
                                                    result.entryTime
                                                ).toLocaleString();


                                            ticketPanel.style.display =
                                                "block";


                                            ticketPanel.scrollIntoView({
                                                behavior: "smooth"
                                            });


                                            await loadAvailability();

                                        }
                                        catch (error) {

                                            console.error(
                                                "Park Error:",
                                                error
                                            );

                                            parkMessage.textContent =
                                                "Unable to process parking request.";
                                        }

                                    }
                                );


                                /* EXIT VEHICLE */

                                exitButton.addEventListener(
                                    "click",
                                    async function () {

                                        const ticketNumber =
                                            exitTicketNumber.value.trim();


                                        if (!ticketNumber) {

                                            exitMessage.textContent =
                                                "Ticket number is required.";

                                            return;
                                        }


                                        try {

                                            const response =
                                                await fetch(
                                                    "/api/parking/exit",
                                                    {
                                                        method: "POST",

                                                        headers: {
                                                            "Content-Type":
                                                                "application/json",

                                                            "Authorization":
                                                                "Bearer " + token
                                                        },

                                                        body: JSON.stringify({

                                                            TicketNumber:
                                                                ticketNumber
                                                        })
                                                    }
                                                );


                                            const result =
                                                await response.json();


                                            if (!response.ok) {

                                                exitMessage.textContent =
                                                    result.message ||
                                                    "Unable to exit vehicle.";

                                                return;
                                            }


                                            exitMessage.innerHTML =
                                                "<strong>Vehicle exited successfully.</strong><br>" +
                                                "Vehicle: " +
                                                result.vehicleNumber +
                                                "<br>" +
                                                "Parking Fee: <strong>Rs. " +
                                                result.parkingFee +
                                                "</strong>";


                                            exitTicketNumber.value = "";


                                            /*
                                             * Automatically put the same ticket
                                             * into payment section.
                                             */

                                            paymentTicketNumber.value =
                                                result.ticketNumber;


                                            await loadAvailability();

                                        }
                                        catch (error) {

                                            console.error(
                                                "Exit Error:",
                                                error
                                            );

                                            exitMessage.textContent =
                                                "Unable to process exit request.";
                                        }

                                    }
                                );


                                /* PAYMENT */

                                paymentButton.addEventListener(
                                    "click",
                                    async function () {

                                        const ticketNumber =
                                            paymentTicketNumber.value.trim();

                                        const method =
                                            paymentMethod.value;


                                        if (!ticketNumber || !method) {

                                            paymentMessage.textContent =
                                                "Ticket number and payment method are required.";

                                            return;
                                        }


                                        try {

                                            const response =
                                                await fetch(
                                                    "/api/parking/payment",
                                                    {
                                                        method: "POST",

                                                        headers: {
                                                            "Content-Type":
                                                                "application/json",

                                                            "Authorization":
                                                                "Bearer " + token
                                                        },

                                                        body: JSON.stringify({

                                                            TicketNumber:
                                                                ticketNumber,

                                                            PaymentMethod:
                                                                method
                                                        })
                                                    }
                                                );


                                            const result =
                                                await response.json();


                                            if (!response.ok) {

                                                paymentMessage.textContent =
                                                    result.message ||
                                                    "Unable to process payment.";

                                                return;
                                            }


                                            paymentMessage.innerHTML =
                                                "<strong>Payment completed successfully.</strong><br>" +
                                                "Amount: <strong>Rs. " +
                                                result.parkingFee +
                                                "</strong><br>" +
                                                "Method: " +
                                                result.paymentMethod;


                                            paymentTicketNumber.value = "";
                                            paymentMethod.value = "";

                                        }
                                        catch (error) {

                                            console.error(
                                                "Payment Error:",
                                                error
                                            );

                                            paymentMessage.textContent =
                                                "Unable to process payment.";
                                        }

                                    }
                                );


                                /* LOGOUT */

                                // Sidebar removed, so no logout button here.

                            });

    </script>

</body>
</html>


