@using System.Configuration

@{
    Layout = null;
    string captchaSiteKey =
        ConfigurationManager.AppSettings["RecaptchaSiteKey"];
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Login | Vehicle Parking System</title>


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">


    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

   
    <link href="/Content/css/login.css"
          rel="stylesheet" />

    <!-- Google reCAPTCHA -->
    <script src="https://www.google.com/recaptcha/api.js"
            async
            defer></script>
</head>


<body>

    <div class="auth-page">

       
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>


        <div class="container">

            <div class="row min-vh-100 align-items-center justify-content-center">

                <div class="col-12 col-sm-10 col-md-7 col-lg-5">

                    <div class="auth-card">


                        
                        <div class="text-center mb-4">

                            <div class="auth-logo">
                                <i class="fa-solid fa-square-parking"></i>
                            </div>

                            <h2 class="auth-title">
                                Welcome Back
                            </h2>

                            <p class="auth-subtitle">
                                Sign in to Vehicle Parking System
                            </p>

                        </div>


                     
                        <form id="loginForm">


                            <!-- Email -->
                            <div class="form-floating mb-1">

                                <input type="email"
                                       class="form-control"
                                       id="email"
                                       placeholder="Email Address">

                                <label for="email">

                                    <i class="fa-regular fa-envelope me-2"></i>

                                    Email Address

                                </label>

                            </div>

                            <div id="emailError"
                                 class="validation-error">
                            </div>


                            <!-- Password -->
                            <div class="input-group mb-1">

                                <div class="form-floating">

                                    <input type="password"
                                           class="form-control"
                                           id="password"
                                           placeholder="Password">

                                    <label for="password">

                                        <i class="fa-solid fa-lock me-2"></i>

                                        Password

                                    </label>

                                </div>


                                <button type="button"
                                        class="btn password-btn"
                                        id="togglePassword">

                                    <i class="fa-regular fa-eye"
                                       id="passwordIcon">
                                    </i>

                                </button>

                            </div>

                            <div id="passwordError"
                                 class="validation-error">
                            </div>


                            <!-- Remember / Forgot -->
                            <div class="d-flex justify-content-between align-items-center mt-3 mb-3">

                                <div class="form-check">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="remember">

                                    <label class="form-check-label"
                                           for="remember">

                                        Remember me

                                    </label>

                                </div>


                                <a href="#"
                                   class="auth-link">

                                    Forgot Password?

                                </a>

                            </div>


                            <!-- CAPTCHA -->
                            <div class="captcha-wrapper">

                                <div class="g-recaptcha"
                                     data-sitekey="@captchaSiteKey">
                                </div>

                            </div>

                            <div id="captchaError"
                                 class="validation-error mt-1">
                            </div>


                            <!-- Server Message -->
                            <div id="message"
                                 class="mt-2">
                            </div>


                            <!-- Login Button -->
                            <button type="submit"
                                    class="btn auth-btn w-100 mt-3"
                                    id="loginButton">

                                <span>Sign In</span>

                                <i class="fa-solid fa-arrow-right ms-2"></i>

                            </button>


                            <!-- Divider -->
                            <div class="auth-divider">
                                <span>SECURE PARKING</span>
                            </div>


                            <p class="text-center register-text mb-0">

                                <i class="fa-solid fa-shield-halved me-1"></i>

                                Secure access protected with JWT

                            </p>


                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <script src="~/Content/login.js"></script>

</body>
</html>